{
  "name": "gds-lens",
  "version": "0.0.0",
  "description": "GDSII & OASIS layout parsing and WebGL2 rendering for the browser",
  "license": "MIT",
  "author": "Ethan Lowenthal",
  "keywords": [
    "gdsii",
    "gds",
    "oasis",
    "oas",
    "layout",
    "layout-viewer",
    "webgl",
    "wasm",
    "lyp",
    "vlsi",
    "eda",
    "ic-layout",
    "chip-design",
    "semiconductor",
    "photonics",
    "drc",
    "lvs",
    "lyrdb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanLowenthal/GDS-Lens"
  },
  "homepage": "https://github.com/EthanLowenthal/GDS-Lens#readme",
  "bugs": {
    "url": "https://github.com/EthanLowenthal/GDS-Lens/issues"
  },
  "scripts": {
    "build:wasm": "emcmake cmake -S src/wasm -B src/wasm/build && cmake --build src/wasm/build",
    "build": "node scripts/build-webview.mjs",
    "watch": "node scripts/build-webview.mjs --watch",
    "test": "node --test test/*.test.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "globals": "^17.11.0",
    "playwright": "^1.62.1"
  },
  "files": [
    "dist/",
    "src/",
    "LICENCE.md",
    "THIRD-PARTY-LICENSES.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/viewer.js",
    "./parsers": "./src/marker-parsers.js",
    "./cell-search": "./src/cell-search.js",
    "./coord-parse": "./src/coord-parse.js",
    "./layout-bytes": "./src/layout-bytes.js",
    "./load-errors": "./src/load-errors.js",
    "./hosts/browser": "./src/hosts/browser.js",
    "./webview/*": "./dist/webview/*",
    "./package.json": "./package.json"
  },
  "type": "module"
}
